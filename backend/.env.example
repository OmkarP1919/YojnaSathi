# ==========================================
# YojnaSathi Backend Environment (Template)
# Copy to backend/.env and fill in real values. NEVER commit .env.
# ==========================================

# ----- Gemini (LLM: /api/chat profile extraction + explanations) -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# ----- Voice providers -----
# STT_PROVIDER: mock | groq | whisper | gemini
#   - groq   : Groq Whisper endpoint (default shown below)
#   - whisper: any OpenAI-compatible endpoint (override WHISPER_BASE_URL/MODEL)
# TTS_PROVIDER: mock | elevenlabs | gemini
#   - mock consumes no external quota and is safe for offline UI testing.
STT_PROVIDER=groq
TTS_PROVIDER=elevenlabs

# Groq Whisper STT (OpenAI-compatible multipart POST /audio/transcriptions).
# WHISPER_API_KEY is preferred; OPENAI_API_KEY is accepted as a fallback.
# Get a Groq key from https://console.groq.com/keys.
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3-turbo
WHISPER_LANGUAGE=
WHISPER_TIMEOUT=30

# ElevenLabs TTS (POST /v1/text-to-speech/{voice_id}, returns audio/mpeg).
# ELEVENLABS_VOICE_ID is REQUIRED for TTS_PROVIDER=elevenlabs. The optional
# VOICE_EN/HI/MR override it per language and otherwise fall back to VOICE_ID.
# Do NOT commit a real key; keep it only in your local .env.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_HI=
ELEVENLABS_VOICE_MR=
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.7
ELEVENLABS_TIMEOUT=30

# ----- Phone channel (CALL-E): outbound scheme-discovery calls -----
# CALLE_API_KEY: API key for the CALL-E service (get from CALL-E dashboard). Do not commit real keys.
# CALLE_BASE_URL: default https://api.heycall-e.com
# CALLE_WEBHOOK_URL: optional HTTPS callback where CALL-E sends call status webhooks.
# Leave commented until a real key exists: the CALL-E service is built at import
# time and treats an empty (but present) CALLE_API_KEY as an auth error.
# CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
# CALLE_WEBHOOK_URL=

# ----- Web scheme discovery (Tavily, OPTIONAL parallel pipeline) -----
# Independent from local matching.py. Leave unset to disable web discovery;
# the existing /api/recommend system works normally without it.
# TAVILY_API_KEY=
# TAVILY_MAX_RESULTS=5
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_COUNTRY=india
# TAVILY_INCLUDE_DOMAINS=
# WEB_SCHEME_CACHE_TTL=3600
# WEB_SCHEME_MAX_CANDIDATES=15
# WEB_SCHEME_VALIDATION_TIMEOUT=10

LOG_LEVEL=INFO
