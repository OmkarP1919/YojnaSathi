# YojnaSathi frontend environment variables.
# Copy this file to frontend/.env and adjust values. Values in a real .env
# are git-ignored and must never be committed.

# CALL-E phone gateway -----------------------------------------------------
# Enable the "Call YojnaSathi" homepage card as a live tel: link by setting
# the configured CALL-E phone number in E.164 international format, e.g.
#   VITE_CALL_PHONE_NUMBER=+919876543210
# Leave empty until the CALL-E phone number is configured. The card then
# shows a friendly "coming soon" note instead of dialing.
VITE_CALL_PHONE_NUMBER=

# Backend API --------------------------------------------------------------
# Optional: override where the frontend calls the backend. Defaults to
# http://localhost:8000 when unset.
#VITE_API_BASE_URL=http://localhost:8000